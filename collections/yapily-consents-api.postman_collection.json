{
  "item": [
    {
      "id": "07d9e4a2-2f5f-46fd-9b54-835165ad6c5e",
      "name": "Consents",
      "description": {
        "content": "The Consents endpoints are used to manage each `Consent` created by Yapily in response to an authorisation created for a user.\n\nThe `Consent` object contains data that identifies a user's consent for a specific `Institution` within a Yapily application. Other than the id of the consent, the `institution-id` for the corresponding `Institution` and the user identifiers (`user-uuid` and `application-user-id`), it contains various details that indicates how the `Consent` can be used.",
        "type": "text/plain"
      },
      "item": [
