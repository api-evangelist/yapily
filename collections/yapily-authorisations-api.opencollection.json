                "name": "psu-corporate-id",
                "value": ""
              },
              {
                "name": "psu-ip-address",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Used to initiate the authorisation process and direct users to the login screen of their financial institution in order to give consent to access account data.\n\nFeature: `INITIATE_ACCOUNT_REQUEST`"
        },
        {
          "info": {
            "name": "Update Account Pre-authorisation",
