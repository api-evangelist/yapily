  "item": [
    {
      "id": "b0c664ba-280f-4f7e-bd55-0c949a88ce41",
      "name": "Institutions",
      "description": {
        "content": "An `Institution` object represents any Account Serving Payment Servicing Provider (ASPSP) that has been integrated and is accessible through the Yapily APIs (ASPSPs are entities that publish Read/Write APIs to permit, with customer consent, payments initiated by third party providers and/or make their customers financial data available to third party providers via their API endpoints).\n\nAny one of the following would be represented as Institution:\n\n- Traditional banks e.g. Santander\n- Neo-banks e.g. Monzo\n- Building societies e.g. Cumberland Building Society",
        "type": "text/plain"
      },
